import os, subprocess
REPO_URL = "https://github.com/alminza/meteo"
REPO_DIR = "/content/meteo"

if not os.path.exists("colab_runner.py"):
    if not os.path.exists(REPO_DIR):
        subprocess.run(["git", "clone", REPO_URL, REPO_DIR], check=False)
    try:
        os.chdir(REPO_DIR)
    except Exception as exc:
        print(f"Could not change directory: {exc}")

print("CWD:", os.getcwd())
print("Repo contents:", os.listdir())# Run Meteo Project in Colab

This notebook installs dependencies and runs the scripts from this repository. If opened from GitHub in Colab, the first cell will clone the repo and set the working directory.